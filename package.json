{
  "name": "preshift",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "build": "tsc -p tsconfig.json && vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "typecheck": "tsc -p tsconfig.json",
    "dev:api": "tsx watch server/index.ts",
    "dev:demo": "PRESHIFT_DEMO=1 node scripts/dev.mjs",
    "dev:web": "vite",
    "start": "tsx server/index.ts",
    "build:vercel": "tsc -p tsconfig.json && node scripts/build-vercel.mjs",
    "eval:assistant": "tsx scripts/eval-assistant.ts"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.137.0",
    "@fastify/swagger": "^8.15.0",
    "@fastify/swagger-ui": "^4.1.0",
    "@neondatabase/serverless": "^0.10.4",
    "fastify": "^4.28.1",
    "qrcode": "1.5.4",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.2.12",
    "@types/node": "^22.9.0",
    "@types/qrcode": "1.5.5",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.3",
    "esbuild": "^0.21.5",
    "tsx": "^4.19.2",
    "typescript": "^5.6.3",
    "vite": "^5.4.10",
    "vitest": "^2.1.4"
  }
}
