# Copy to .env.local for development and add the same names to the Vercel project for production.

# Neon connection string.
DATABASE_URL=

# Public address of the app, used to build links in emails. Required in production; never
# derived from the request, so a forged Host header cannot redirect reset links.
APP_URL=https://preshift-nine.vercel.app

# Resend (resend.com) for password reset emails. MAIL_FROM must be on a domain verified in Resend.
# Leave blank in development to have emails printed to the dev server console instead.
RESEND_API_KEY=
MAIL_FROM=Preshift Rota <no-reply@preshift.co.uk>
